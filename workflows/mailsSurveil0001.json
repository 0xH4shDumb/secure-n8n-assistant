    {
      "id": "n-nouveaux",
      "name": "Nouveaux mails ?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        300
      ],
      "parameters": {
        "jsCode": "// Repère les mails jamais signalés et prépare une notification avec boutons pour chacun.\nconst COMPTES = { P: 'Compte1', C: 'Compte2', J: 'Compte3' };\nconst MAX_NOTIFS = 5;\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst court = (s, n) => (s.length > n ? s.slice(0, n - 1) + '…' : s);\nconst masquer = s => String(s).replace(/\\d[\\d -]{2,}\\d/g, m => (m.replace(/\\D/g, '').length >= 4 ? '••••' : m));\nconst expediteur = from => (from.match(/^\\s*\"?([^\"<]+?)\"?\\s*</)?.[1] ?? from).trim();\nconst lire = nom => { try { return $(nom).all().map(i => i.json); } catch { return []; } };\n\nconst mem = $getWorkflowStaticData('global');\nmem.vus ??= {};\nconst premiereFois = !mem.init;\nconst maintenant = Date.now();\n\nconst nouveaux = [];\nfor (const [code, nom] of Object.entries(COMPTES)) {\n  for (const m of lire(`Détails – ${nom}`)) {\n    if (!m.payload || !m.id || mem.vus[m.id]) continue;\n    mem.vus[m.id] = maintenant;\n    const h = n => m.payload.headers?.find(x => x.name.toLowerCase() === n)?.value ?? '';\n    nouveaux.push({ code, nom, id: m.id, de: expediteur(h('from')), sujet: h('subject') || '(sans sujet)',\n                    apercu: m.snippet ?? '', ecole: /school\\.example/i.test(h('from') + h('to') + h('cc')) });\n  }\n}\nfor (const [id, t] of Object.entries(mem.vus)) if (maintenant - t > 7 * 24 * 3600 * 1000) delete mem.vus[id];\n\n// Pour le tableau de bord : les derniers mails signalés (48 h, 20 au maximum), chiffres masqués\nif (!premiereFois) {\n  mem.recents = [...nouveaux.map(n => ({ id: n.id, code: n.code, compte: n.nom, de: n.de, sujet: masquer(n.sujet), ecole: n.ecole, date: maintenant })),\n                 ...(mem.recents ?? [])].filter(r => maintenant - r.date < 48 * 3600 * 1000).slice(0, 20);\n}\n\n// Première exécution : on mémorise l'existant sans rien signaler (pas d'avalanche de notifications)\nif (premiereFois) {\n  mem.init = true;\n  return [{ json: { texte: `📬 <b>Surveillance des mails activée</b>\\nJe te préviendrai des prochains mails importants (${nouveaux.length} déjà présents ignorés).` } }];\n}\n\nconst sorties = nouveaux.slice(0, MAX_NOTIFS).map(n => ({ json: {\n  texte: `📬 <b>Nouveau mail</b> — ${n.nom}${n.ecole ? ' · 🎓 École' : ''}\\n<b>De :</b> ${esc(court(n.de, 60))}\\n<b>Objet :</b> ${esc(court(masquer(n.sujet), 120))}\\n<i>${esc(court(masquer(n.apercu), 160))}</i>`,\n  boutons: [[{ texte: '✍️ Préparer une réponse', donnee: `rep:${n.code}:${n.id}` }, { texte: '🙈 Ignorer', donnee: `ign:${n.code}:${n.id}` }]],\n} }));\nif (nouveaux.length > MAX_NOTIFS) sorties.push({ json: { texte: `📬 … et ${nouveaux.length - MAX_NOTIFS} autre(s) mail(s) important(s). Détail avec /rapport.` } });\nreturn sorties;\n"
      },
      "executeOnce": true
    },
